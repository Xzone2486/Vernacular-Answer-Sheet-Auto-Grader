# Backend Settings
ENV=development
LOG_LEVEL=info

# Database Settings
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/vernacular_db

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Scoring Engine
SCORING_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2
SCORING_LOW_THRESHOLD=0.3
SCORING_HIGH_THRESHOLD=0.8
SCORING_KEYWORD_THRESHOLD=0.5

# Frontend Settings
VITE_API_URL=http://localhost:8000
